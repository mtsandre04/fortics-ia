<mxfile host="app.diagrams.net">
  <diagram id="workflow-ixc" name="Atendimento Virtual IXC">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Início do atendimento virtual" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="consulta" value="Consultar cliente para obter o ID no IXC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="verifica" value="Verificar atendimentos do cliente no IXC&lt;br&gt;&lt;i&gt;(status: Novo, Pendente ou Em progresso)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="220" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="decisao" value="Existe atendimento em aberto?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="330" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="informa" value="&lt;b&gt;Informar andamento ao cliente&lt;/b&gt;&lt;br&gt;• Status atual do chamado&lt;br&gt;• Interação do técnico&lt;br&gt;• Ordem de serviço vinculada" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="20" y="345" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="abre" value="Abrir atendimento normalmente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fim" value="Fim" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="510" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="consulta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="consulta" target="verifica">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="verifica" target="decisao">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="1" source="decisao" target="informa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="1" source="decisao" target="abre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="informa" target="fim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="535" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="abre" target="fim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="535" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
