          "name": "retorno",
          "type": "code",
          "value": "\nconst data = _vars._request.body || _vars._request.data || {};\n\n// ORGANIZAÇÃO DOS PARÂMETROS PARA A API IXC\nreturn {\n    tipo: String(data.tipo || \"\"),\n    id_cliente: String(data.id_cliente || \"\"),\n    titulo: String(data.titulo || \"\"),\n    menssagem: String(data.menssagem || \"\"),\n    prioridade: String(data.prioridade || \"\"),\n    su_status: String(data.su_status || \"\"),\n    status: String(data.status || \"\"),\n    id_assunto: String(data.id_assunto || \"\"),\n    id_ticket_setor: String(data.id_ticket_setor || \"\"),\n    data_reservada: String(data.data_agenda || \"\")\n};\n"
        },
